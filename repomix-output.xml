@layer utilities {
  .sidebar-transition {
    transition-property: width, left, right, margin;
    transition-duration: 300ms;
    transition-timing-function: theme('transitionTimingFunction.sidebar');
    will-change: width, left, right, margin;
  }

  /* GPU acceleration for sidebar animations */
  [data-sidebar="sidebar"] {
    transform: translateZ(0);
    backface-visibility: hidden;
  }

  /* Prevent text flickering during width transitions */
  .group\/sidebar-wrapper [data-sidebar="sidebar"] * {
    backface-visibility: hidden;
  }

  /* Smooth icon-only mode transition */
  [data-collapsible="icon"] [data-sidebar="menu-button"] span:last-child {
    transition: opacity 150ms ease-out;
  }

  [data-state="collapsed"][data-collapsible="icon"] [data-sidebar="menu-button"] span:last-child {
    opacity: 0;
    visibility: hidden;
    transition: opacity 100ms ease-in, visibility 0ms 100ms;
  }

  /* Stock detail transitions */
  .stock-detail-enter {
    animation: stockDetailFadeIn 0.3s ease-out;
  }

  @keyframes stockDetailFadeIn {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Custom thin scrollbar for financial tables */
  .scrollbar-thin {
    scrollbar-width: thin;
    scrollbar-color: hsl(var(--muted-foreground) / 0.3) transparent;
  }

  .scrollbar-thin::-webkit-scrollbar {
    height: 6px;
    width: 6px;
  }

  .scrollbar-thin::-webkit-scrollbar-track {
    background: transparent;
  }

  .scrollbar-thin::-webkit-scrollbar-thumb {
    background-color: hsl(var(--muted-foreground) / 0.3);
    border-radius: 3px;
  }

  .scrollbar-thin::-webkit-scrollbar-thumb:hover {
    background-color: hsl(var(--muted-foreground) / 0.5);
