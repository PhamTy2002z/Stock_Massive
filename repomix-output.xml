        # Try to insert duplicate
        with pytest.raises(IntegrityError) as exc_info:
            async with async_session_factory() as session:
                bar2 = StockIntradayBar(
                    symbol="UNIQ",
                    bar_time=bar_time,  # Same symbol and bar_time
