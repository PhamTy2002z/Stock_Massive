│   │
│   └── api/                      # FastAPI backend
│       ├── src/
│       │   ├── stocks/           # Stocks module
│       │   │   ├── market/       # Symbols, sectors, fund certificates
│       │   │   ├── price/        # History, intraday, indices, volume analysis
