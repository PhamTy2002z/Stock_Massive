      {/* Description */}
      <div className="p-4 border-t border-border">
        <p className="text-sm text-muted-foreground line-clamp-4">
          {description}
        </p>
        <button className="mt-2 text-sm text-primary hover:underline cursor-pointer">
          Xem chi tiết
        </button>
      </div>
    </div>
  )
}

// Info Row Component
