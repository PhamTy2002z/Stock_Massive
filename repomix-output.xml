  return (
    <Card className={cn("w-full", className)}>
      <CardHeader>
        <div className="h-6 w-48 bg-muted animate-pulse rounded" />
        <div className="h-4 w-64 bg-muted animate-pulse rounded mt-2" />
      </CardHeader>
      <CardContent>
        <div className="h-[400px] bg-muted animate-pulse rounded" />
      </CardContent>
    </Card>
  )
}
