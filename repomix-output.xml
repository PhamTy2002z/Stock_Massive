          </span>
        </div>
      </td>
      <td className="py-3 px-4 text-sm text-right tabular-nums text-foreground/90">
        {formatVolume(stock.volume)}
      </td>
      <td className="py-3 px-4 text-sm text-right tabular-nums text-foreground/90">
        {formatMarketCap(stock.market_cap)}
      </td>
    </tr>
  )
})

// In the main component, update the tbody:
