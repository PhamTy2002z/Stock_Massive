  "date": "2024-12-27",
  "buy_orders": 1487,
  "sell_orders": 1600,
  "buy_volume": 1128200,
  "sell_volume": 1069500,
  "net_volume": 58700,
  "ato_volume": 15500,
  "atc_volume": 185700,
  "last_updated": "2024-12-27T14:30:00"
}
```

## Dependencies

