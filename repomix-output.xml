<file path="apps/web/temp/get_foreign_trading_data.py">
from vnstock.api.trading import Trading
import pandas as pd
from datetime import datetime, timedelta

# Define parameters
symbol = 'VCI'
source = 'VCI' # Or 'TCBS', but VCI is recommended
end_date = datetime.now()
start_date = end_date - timedelta(days=30) # Get data for the last 30 days

start_date_str = start_date.strftime('%Y-%m-%d')
end_date_str = end_date.strftime('%Y-%m-%d')

print(f"Attempting to retrieve foreign trading data for {symbol} from {start_date_str} to {end_date_str} using source {source}...")

try:
    # Instantiate the Trading class directly from vnstock.api.trading
    trading_api = Trading(source=source, symbol=symbol)

    # Call the foreign_trade method
    foreign_trade_data = trading_api.foreign_trade(
        symbol=symbol,
        start_date=start_date_str,
        end_date=end_date_str
    )

    if not foreign_trade_data.empty:
        print("\nForeign Trading Data:")
        print(foreign_trade_data)
        # Optionally, save to CSV for easier inspection
        foreign_trade_data.to_csv(f'foreign_trade_data_{symbol}.csv', index=False)
        print(f"\nData saved to foreign_trade_data_{symbol}.csv")
    else:
        print("\nNo foreign trading data found for the specified period.")

except Exception as e:
    print(f"\nAn error occurred: {e}")
    print("Please ensure your 'vnstock' package is up-to-date (pip install --upgrade vnstock) and the API is accessible.")
