        """Test GET /api/v1/stocks/symbols."""
        response = client.get("/api/v1/stocks/symbols")

        assert response.status_code == 200
        data = response.json()
        assert isinstance(data, list)
        assert len(data) > 0
        # Validate schema
        assert "symbol" in data[0]

