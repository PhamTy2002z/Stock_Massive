# ========================================
# Stock Massive Web - Production Dockerfile
# ========================================
# Multi-stage build for optimized Next.js production image

# Pinned, not @latest: pnpm 10 ignores the pnpm.overrides block in
# package.json and enforces a release-age policy the lockfile fails.
ARG PNPM_VERSION=9.15.9

# Stage 1: Dependencies
FROM node:22-alpine AS deps

WORKDIR /app

# Install pnpm
ARG PNPM_VERSION
RUN corepack enable && corepack prepare pnpm@${PNPM_VERSION} --activate

# Copy package files
COPY package.json pnpm-lock.yaml ./

# Install dependencies
RUN pnpm install --frozen-lockfile

# Stage 2: Builder
FROM node:22-alpine AS builder

WORKDIR /app

# Install pnpm
ARG PNPM_VERSION
RUN corepack enable && corepack prepare pnpm@${PNPM_VERSION} --activate

# Copy deps from previous stage
COPY --from=deps /app/node_modules ./node_modules
COPY . .

# Build args for env vars at build time
ARG NEXT_PUBLIC_API_URL

ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL

# Build application
RUN pnpm build

# Stage 3: Production
FROM node:22-alpine AS production

WORKDIR /app

# Create non-root user
RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 nextjs

# Copy built assets.
#
# `next.config.ts` sets `outputFileTracingRoot` to two levels above the app, for
# the repo layout on a developer's machine. The build context here is the app
# itself at `/app`, so that root resolves to `/` — and a standalone bundle
# mirrors the tree *below its tracing root*, which puts the server at
# `app/server.js` rather than at the top. `static` and `public` have to sit
# beside that server or Next serves neither, and the process exits with
# `Cannot find module '/app/server.js'` when they are copied to the top instead.
#
# The same offset is why `apps/web/playwright.config.ts` runs
# `.next/standalone/apps/web/server.js`: on the host the tracing root is the
# repository, so the app lands under `apps/web/`.
COPY --from=builder --chown=nextjs:nodejs /app/.next/standalone ./
COPY --from=builder /app/public ./app/public
COPY --from=builder --chown=nextjs:nodejs /app/.next/static ./app/.next/static

# Switch to non-root user
USER nextjs

# Expose port
EXPOSE 3000

# Set environment
ENV NODE_ENV=production
ENV PORT=3000
ENV HOSTNAME="0.0.0.0"

# Health check
# ``127.0.0.1`` rather than ``localhost``: inside the container that name
# resolves to ``::1`` first, and the server listens on ``0.0.0.0`` — IPv4 only.
# The check then reports a refused connection while the service answers every
# request, which is the worst way for a healthcheck to be wrong: it fails a
# rollout gate over a healthy container.
HEALTHCHECK --interval=30s --timeout=10s --start-period=15s --retries=3 \
    CMD wget --no-verbose --tries=1 --spider http://127.0.0.1:3000 || exit 1

# Start application. `app/` for the reason the copies above explain.
CMD ["node", "app/server.js"]
