      items: [
        { title: "Overview", url: "#" },
        { title: "Stocks", url: "#" },
        { title: "Indices", url: "#" },
        { title: "Sectors", url: "#" },
      ],
    },
    {
      title: "Charts",
      url: "#",
      icon: LineChart,
      items: [
        { title: "TradingView", url: "#" },
        { title: "Technical Analysis", url: "#" },
        { title: "Comparisons", url: "#" },
      ],
    },
    {
      title: "Screener",
      url: "#",
      icon: Table2,
      items: [
