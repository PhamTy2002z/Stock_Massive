  const isFetching =
    healthScore.isFetching ||
    trendMetrics.isFetching ||
    sectorPeers.isFetching ||
    fcfAnalysis.isFetching

  return {
    healthScore,
    trendMetrics,
    sectorPeers,
    fcfAnalysis,
    isFetching,
  }
}
