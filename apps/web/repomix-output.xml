    animation: stockDetailFadeIn 0.3s ease-out;
  }

  @keyframes stockDetailFadeIn {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Custom thin scrollbar for financial tables */
  .scrollbar-thin {
    scrollbar-width: thin;
    scrollbar-color: hsl(var(--muted-foreground) / 0.3) transparent;
  }

  .scrollbar-thin::-webkit-scrollbar {
    height: 6px;
    width: 6px;
  }

  .scrollbar-thin::-webkit-scrollbar-track {
    background: transparent;
  }

  .scrollbar-thin::-webkit-scrollbar-thumb {
    background-color: hsl(var(--muted-foreground) / 0.3);
    border-radius: 3px;
  }

  .scrollbar-thin::-webkit-scrollbar-thumb:hover {
    background-color: hsl(var(--muted-foreground) / 0.5);
  }

  /* Performance Optimizations - Phase 4 */

  /* Global smooth scroll behavior */
  html {
    scroll-behavior: smooth;
  }

  /* GPU-accelerated scroll containers */
  .scroll-gpu {
    transform: translateZ(0);
    -webkit-overflow-scrolling: touch;
  }

  /* Prevent scroll chaining to parent */
  .overscroll-contain {
    overscroll-behavior: contain;
  }

  /* Table scroll container optimization */
  .table-scroll-container {
    overscroll-behavior-x: contain;
    -webkit-overflow-scrolling: touch;
    transform: translateZ(0);
  }

  /* Content containment for performance */
  .contain-content {
    contain: content;
  }

  /* Fetching state opacity indicator */
  .fetching-opacity {
    transition: opacity 0.15s ease-out;
  }

  .fetching-opacity[data-fetching="true"] {
    opacity: 0.7;
  }
}
</file>

