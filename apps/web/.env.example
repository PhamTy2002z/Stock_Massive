# Copy to .env.local — the frontend runs on the host with `pnpm dev`.

# API base URL used by the browser
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# API base URL used by server components / route handlers.
# Running on the host, this is the same localhost URL as above, so it can stay
# unset. Only set it when the frontend itself runs inside Docker, where the API
# is reachable at the compose service name instead:
# INTERNAL_API_URL=http://api:8000/api/v1

NEXT_PUBLIC_SITE_URL=http://localhost:3000
