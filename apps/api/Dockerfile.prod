# ========================================
# Stock Massive API - Production Dockerfile
# ========================================
# Multi-stage build for optimized production image

# Stage 1: Builder
FROM python:3.11-slim AS builder

WORKDIR /code

# Install build dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    g++ \
    python3-dev \
    && rm -rf /var/lib/apt/lists/*

# Install Python dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir --user -r requirements.txt

# Stage 2: Production
FROM python:3.11-slim AS production

WORKDIR /code

# Install runtime dependencies only
RUN apt-get update && apt-get install -y --no-install-recommends \
    netcat-openbsd \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --create-home --shell /bin/bash app

# Copy Python packages from builder
COPY --from=builder /root/.local /home/app/.local
ENV PATH=/home/app/.local/bin:$PATH

# Copy application code
COPY --chown=app:app . .

# Make entrypoint executable
RUN chmod +x entrypoint.sh

# Switch to non-root user
USER app

# Expose port
EXPOSE 8000

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8000/health')" || exit 1

# Run with entrypoint
# NOTE: Using single worker (--workers 1) because APScheduler requires single process
# Multiple workers would each run their own scheduler, causing duplicate job execution
# The collection cycle runs in this process too, and the free FiinQuant tier grants a
# single concurrent connection — a second worker would disconnect the first mid-cycle.
# Splitting the collector into its own container is what unlocks more workers
# (docs/adr/0001).
#
# `--timeout-graceful-shutdown` is load-bearing for Alpha Desk. Uvicorn waits for
# open connections before running the ASGI lifespan's shutdown, and an SSE
# subscriber holds its connection for the length of the Turn — so with no timeout
# the 30 seconds of Turn checkpointing (docs/adr/0013) would not begin until the
# ten-minute deadline expired, by which point the deploy has already killed the
# container. Ten seconds is long enough for ordinary requests to finish and short
# enough that the checkpoint window fits inside the container's stop grace
# (docs/streaming-topology.md).
ENTRYPOINT ["./entrypoint.sh"]
CMD ["uvicorn", "src.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1", "--timeout-graceful-shutdown", "10"]
