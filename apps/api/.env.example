# ========================================
# Stock Massive API - Environment Variables
# ========================================

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=false

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/stockmassive

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3000

# Vnstock data source (VCI is most reliable)
VNSTOCK_SOURCE=VCI

# Upstash Redis (optional - for rate limiting)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Scheduler settings
SCHEDULER_ENABLED=true
INTRADAY_COLLECT_HOUR=15
INTRADAY_COLLECT_MINUTE=30
INTRADAY_SYMBOLS=VCB,FPT,VNM,VIC,VHM
INTRADAY_RETENTION_DAYS=30

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_STANDARD_MAX=100
RATE_LIMIT_STANDARD_WINDOW=60
RATE_LIMIT_HEAVY_MAX=20
RATE_LIMIT_HEAVY_WINDOW=60

# Google OAuth
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Auth Secret (generate with: openssl rand -base64 32)
AUTH_SECRET=

# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=