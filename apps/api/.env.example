# ========================================
# Stock Massive API - Environment Variables
# ========================================

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=false

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/stockmassive

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3000

# Vnstock data source (VCI is most reliable)
VNSTOCK_SOURCE=VCI

# Universe — the symbols the system collects and serves, capped at 100 in all.
# BREAKING as of the Profit Ranking Census: only 50 of those places may be
# declared here. The other 50 are reserved for the Profit Leaders Cohort, which
# the census reseats from the market's own profit figures (docs/adr/0003).
# The app refuses to start on a malformed symbol or on more than 50 declared.
# Empty is valid: the app runs and the collector has nothing to do.
UNIVERSE_SYMBOLS=

# Upstash Redis (optional - for rate limiting)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# vnstock API key (free at https://vnstocks.com/login)
# Without it the quota is 20 req/min; with it, 60.
VNSTOCK_API_KEY=

# Scheduler settings
SCHEDULER_ENABLED=true
# Fill the daily spine by itself at 16:30 Vietnam time (index, declared,
# market in turn). Off by default: the market scope is 1,523 provider calls.
BACKFILL_DAILY_SCHEDULED=false

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_STANDARD_MAX=100
RATE_LIMIT_STANDARD_WINDOW=60
RATE_LIMIT_HEAVY_MAX=20
RATE_LIMIT_HEAVY_WINDOW=60

# Alpha Desk — the LLM route (docs/adr/0014, docs/specs/0003 §3).
# Off by default. With it on, Budget Validation runs at startup and refuses to
# boot on a configuration whose prices cannot fund one Analysis under $0.015 or
# one Turn under $0.50; with it off, the same finding is only logged.
ALPHA_DESK_ENABLED=false
LLM_BASE_URL=
LLM_API_KEY=
# The two workload models. These ids live only in configuration — a route change
# is an env-var flip, which is the whole reason the LLMClient boundary exists.
LLM_MODEL_BATCH=gpt-5.6-luna
LLM_MODEL_SESSION=gpt-5.6-terra
LLM_REQUEST_TIMEOUT_SECONDS=120
# Explicitly disable only when a process must not make the paid boot-time probe.
LLM_CAPABILITY_PROBE_ENABLED=true

# Prices in USD per million tokens, per workload. Zero is refused rather than
# read as free. Reasoning tokens bill at the output price.
LLM_PRICING_VERSION=
LLM_PRICING_EFFECTIVE_DATE=
LLM_PRICE_BATCH_INPUT_USD_PER_MTOK=0
LLM_PRICE_BATCH_CACHED_INPUT_USD_PER_MTOK=0
LLM_PRICE_BATCH_CACHE_WRITE_USD_PER_MTOK=0
LLM_PRICE_BATCH_OUTPUT_USD_PER_MTOK=0
LLM_PRICE_SESSION_INPUT_USD_PER_MTOK=0
LLM_PRICE_SESSION_CACHED_INPUT_USD_PER_MTOK=0
LLM_PRICE_SESSION_CACHE_WRITE_USD_PER_MTOK=0
LLM_PRICE_SESSION_OUTPUT_USD_PER_MTOK=0

# The $45/month envelope and the three lanes sharing it. They must add up to the
# envelope exactly, and each must fund one unit of its own workload.
LLM_BUDGET_MONTHLY_USD=45
LLM_BUDGET_ANALYSIS_USD=10
LLM_BUDGET_TURN_USD=30
LLM_BUDGET_EMERGENCY_USD=5

# Auth (JWT signing — generate with: openssl rand -base64 32)
AUTH_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
