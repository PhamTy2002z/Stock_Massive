    sell_orders: int = 0
    buy_volume: int = 0
    sell_volume: int = 0
    avg_buy_order: float = 0
    avg_sell_order: float = 0


class OrderStatsResponse(BaseModel):
    """Response for order stats endpoint."""

    symbol: str
    items: list[OrderStatsItem]


