from datetime import date
from typing import Optional

from pydantic import BaseModel


# === Foreign Trading Schemas ===


class ForeignTradingItem(BaseModel):
    """Single day foreign trading data."""

    date: str
    net_volume: int = 0
    net_value: int = 0
    buy_volume: int = 0
    buy_value: int = 0
    sell_volume: int = 0
    sell_value: int = 0
