# ========================================
# Stock Massive - Docker Environment
# ========================================
# Copy to .env and update values
# API
AUTH_SECRET=generate-with-openssl-rand-base64-32
CORS_ORIGINS=http://localhost:3000

# Frontend (for production builds)
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Upstash Redis (optional)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Google OAuth (optional)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# NextAuth Secret (generate with: openssl rand -base64 32)
AUTH_SECRET=

# Supabase Database (Runtime - Session pooler)
DATABASE_URL=postgresql://postgres.efflhacmqiypqhxcgohk:<___>%40@aws-1-ap-south-1.pooler.supabase.com:5432/postgres?sslmode=require

# Supabase Database (Migrations - Direct connection)  
DATABASE_URL_DIRECT=postgresql://postgres:<____>%40@db.efflhacmqiypqhxcgohk.supabase.co:5432/postgres

# Scheduler
SCHEDULER_ENABLED=true
