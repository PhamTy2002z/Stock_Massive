# ========================================
# Stock Massive - Docker Environment
# ========================================
# Copy to .env and update values

# Database (local Postgres from docker-compose)
# Point this at any Postgres to move off local — add ?sslmode=require for managed hosts.
DATABASE_URL=postgresql://postgres:postgres@db:5432/stockmassive
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=stockmassive
# Host port for the db container; change if 5432 is taken by another stack.
POSTGRES_PORT=5432

# Auth (JWT signing — generate with: openssl rand -base64 32)
AUTH_SECRET=generate-with-openssl-rand-base64-32
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# API
CORS_ORIGINS=http://localhost:3000

# Frontend (for production builds)
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Upstash Redis (optional)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Scheduler
SCHEDULER_ENABLED=true
