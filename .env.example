# ========================================
# Stock Massive - Backend (Docker) Environment
# ========================================
# Copy to .env and update values.
# This file configures the containers in docker-compose.yml (db + api).
# The frontend runs on the host and reads apps/web/.env.local instead.

# Database (local Postgres from docker-compose)
# Point this at any Postgres to move off local — add ?sslmode=require for managed hosts.
DATABASE_URL=postgresql://postgres:postgres@db:5432/stockmassive
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=stockmassive
# Host port for the db container; change if 5432 is taken by another stack.
POSTGRES_PORT=5432

# Auth (JWT signing — generate with: openssl rand -base64 32)
AUTH_SECRET=generate-with-openssl-rand-base64-32
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# API
# Origin of the host-side Next.js dev server. If you start the frontend on a
# different port, update this or the browser's API calls get rejected by CORS.
CORS_ORIGINS=http://localhost:3000
# Host port for the api container; change if 8000 is taken by another stack.
API_PORT=8000

# Web (only used by the opt-in `--profile full` web container)
# Host port for that container. If you change it, update CORS_ORIGINS to match.
WEB_PORT=3000

# Compose project name — prefixes images and networks. Only override this when
# running a second stack (e.g. from a git worktree) alongside the main one.
# COMPOSE_PROJECT_NAME=stockmassive

# Frontend API base URL, passed to the `--profile full` web container and to
# production builds. The host-side dev server reads apps/web/.env.local.
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Upstash Redis (optional)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ========================================
# Alpha Desk — the LLM route (docs/adr/0014, docs/specs/0003 §3)
# ========================================
# Off by default. With it on, Budget Validation runs at startup and refuses to
# boot on a configuration whose prices cannot fund the ceilings below; with it
# off, the same finding is only logged.
ALPHA_DESK_ENABLED=false

# The route. Dev points this at a local CLIProxyAPI; production points it at the
# provider. Never commit a real credential — .env is ignored, .env.example is not.
LLM_BASE_URL=
LLM_API_KEY=

# The two workload models. These ids live only here: a route change is an
# env-var flip, which is the whole reason the LLMClient boundary exists.
LLM_MODEL_BATCH=gpt-5.6-luna
LLM_MODEL_SESSION=gpt-5.6-terra
LLM_REQUEST_TIMEOUT_SECONDS=120
# Explicitly disable only when a process must not make the paid boot-time probe.
LLM_CAPABILITY_PROBE_ENABLED=true

# Whether the route reads images. Off until `make probe-vision` (in apps/api)
# passes, for the same reason cache_control ships off: the only way to know what
# a proxied route does with a block nobody measured is to send it one. Copy the
# model it passed on into the second variable — startup warns when the two drift
# apart, because the flag itself knows nothing about which model was measured.
LLM_VISION_ENABLED=false
LLM_VISION_MEASURED_MODEL=

# The pricing block, in USD per million tokens, per workload. Zero is refused
# rather than read as free. Reasoning tokens bill at the output price, which is
# why five token counters meet four prices.
LLM_PRICING_VERSION=
LLM_PRICING_EFFECTIVE_DATE=
LLM_PRICE_BATCH_INPUT_USD_PER_MTOK=0
LLM_PRICE_BATCH_CACHED_INPUT_USD_PER_MTOK=0
LLM_PRICE_BATCH_CACHE_WRITE_USD_PER_MTOK=0
LLM_PRICE_BATCH_OUTPUT_USD_PER_MTOK=0
LLM_PRICE_SESSION_INPUT_USD_PER_MTOK=0
LLM_PRICE_SESSION_CACHED_INPUT_USD_PER_MTOK=0
LLM_PRICE_SESSION_CACHE_WRITE_USD_PER_MTOK=0
LLM_PRICE_SESSION_OUTPUT_USD_PER_MTOK=0

# The $45/month envelope and the three lanes sharing it. The lanes must add up
# to the envelope exactly, and each must fund one unit of its own workload.
#
# Set all four to 0 for a route billed by subscription rather than per call:
# that declares no monthly envelope, and every token and cost row is still
# written to the ledger. All four or none — a single 0 among three funded lanes
# is a variable somebody forgot to fill in, and startup fails on it.
LLM_BUDGET_MONTHLY_USD=45
LLM_BUDGET_ANALYSIS_USD=10
LLM_BUDGET_TURN_USD=30
LLM_BUDGET_EMERGENCY_USD=5

# The five per-user ceilings. 0 disables one of them without touching the rest;
# the call is still metered, only the refusal goes away.
# LLM_SYSTEM_ACTIVE_TURNS sizes the in-process semaphore as well as the ledger
# check, because the two enforce the same number from opposite sides.
LLM_USER_TURN_STARTS_PER_DAY=20
LLM_USER_ACTIVE_TURNS=1
LLM_SYSTEM_ACTIVE_TURNS=3
LLM_USER_DAILY_USD=3
LLM_USER_ROLLING_30D_USD=15
