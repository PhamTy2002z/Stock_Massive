# Dependencies
node_modules/
.pnpm-store/
__pycache__/
*.py[cod]
.venv/
venv/
env/

# Build outputs
.next/
out/
dist/
build/
*.egg-info/
# tsc's incremental cache: rewritten by every type-check, so tracking it makes
# every branch conflict with itself
*.tsbuildinfo

# Playwright's run artefacts from the streaming acceptance: traces and reports,
# regenerated on every run
apps/web/test-results/
apps/web/playwright-report/

# Environment
.env
.env.local
.env.*.local
# Timestamped copies made before editing .env carry the same secrets
.env.bak*

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log
logs/

# Testing
coverage/
.coverage
htmlcov/
.pytest_cache/

# Docker
postgres_data/

# Database dumps and exports (share via cloud storage, not git).
# A SQL file that genuinely belongs in the repo goes in with `git add -f`.
*.sql
*.sql.gz
*.dump
*.dump.gz
apps/web/temp/

# Codebase snapshots (regenerate with repomix, don't commit)
repomix-output.xml

# Dropped into apps/api by the vnstock package on install, not ours
apps/api/AGENTS.md

# Local scratch (venvs, throwaway scripts)
.scratch/

# Feature worktrees live here; each is its own checkout
.claude/worktrees/
